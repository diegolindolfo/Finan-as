{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the finance app.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "name": {
          "type": "string",
          "description": "The user's display name."
        },
        "familyId": {
          "type": "string",
          "description": "The ID of the family/household this user belongs to. Defaults to their own UID."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL to the user's profile picture."
        }
      },
      "required": ["email", "name", "familyId"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A financial transaction (income or expense).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the transaction."
        },
        "description": {
          "type": "string",
          "description": "Description of the transaction."
        },
        "amount": {
          "type": "number",
          "description": "The monetary amount."
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense", "transfer"],
          "description": "Whether it's an income, an expense, or a transfer."
        },
        "category": {
          "type": "string",
          "description": "The category of the transaction."
        },
        "date": {
          "type": "string",
          "description": "The date of the transaction in ISO format."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the transaction was created."
        },
        "createdBy": {
          "type": "string",
          "description": "The UID of the user who created the transaction."
        }
      },
      "required": ["id", "description", "amount", "type", "category", "date", "createdAt", "createdBy"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Family financial settings.",
      "type": "object",
      "properties": {
        "monthlyIncome": {
          "type": "number",
          "description": "The combined monthly income."
        },
        "spendingCapPercentage": {
          "type": "number",
          "description": "The percentage of income set as a spending limit."
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "description": "UI theme preference."
        },
        "currency": {
          "type": "string",
          "description": "Currency code (e.g., BRL)."
        },
        "accentColor": {
          "type": "string",
          "enum": ["green", "pink"],
          "description": "The accent color theme."
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether push notifications are enabled."
        }
      },
      "required": ["monthlyIncome", "spendingCapPercentage", "theme", "currency"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "A notification for the user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the notification."
        },
        "title": {
          "type": "string",
          "description": "The title of the notification."
        },
        "message": {
          "type": "string",
          "description": "The message body of the notification."
        },
        "type": {
          "type": "string",
          "enum": ["alert", "summary", "info", "bill", "motivation"],
          "description": "The type of notification."
        },
        "read": {
          "type": "boolean",
          "description": "Whether the notification has been read."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the notification was created."
        }
      },
      "required": ["id", "title", "message", "type", "read", "createdAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "A shared financial goal.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the goal."
        },
        "title": {
          "type": "string",
          "description": "The title of the goal."
        },
        "targetAmount": {
          "type": "number",
          "description": "The target amount to reach."
        },
        "currentAmount": {
          "type": "number",
          "description": "The current amount saved."
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "description": "The deadline for the goal."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the goal was created."
        },
        "createdBy": {
          "type": "string",
          "description": "The UID of the user who created the goal."
        },
        "icon": {
          "type": "string",
          "description": "Icon name for the goal."
        },
        "color": {
          "type": "string",
          "description": "Color code for the goal."
        }
      },
      "required": ["id", "title", "targetAmount", "currentAmount", "createdAt", "createdBy"]
    },
    "Bill": {
      "title": "Bill",
      "description": "An upcoming bill or payment.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the bill."
        },
        "title": {
          "type": "string",
          "description": "The title of the bill."
        },
        "amount": {
          "type": "number",
          "description": "The amount of the bill."
        },
        "dueDate": {
          "type": "string",
          "format": "date-time",
          "description": "The due date of the bill."
        },
        "category": {
          "type": "string",
          "description": "The category of the bill."
        },
        "paid": {
          "type": "boolean",
          "description": "Whether the bill has been paid."
        },
        "recurring": {
          "type": "boolean",
          "description": "Whether the bill is recurring."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the bill was created."
        },
        "createdBy": {
          "type": "string",
          "description": "The UID of the user who created the bill."
        }
      },
      "required": ["id", "title", "amount", "dueDate", "category", "paid", "recurring", "createdAt", "createdBy"]
    },
    "CategoryMapping": {
      "title": "CategoryMapping",
      "description": "A mapping between a transaction description keyword and a category.",
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "description": "The keyword or description to match."
        },
        "category": {
          "type": "string",
          "description": "The category to assign."
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "The type of transaction."
        }
      },
      "required": ["keyword", "category", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles and their family association."
    },
    "/families/{familyId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/Transaction"
      },
      "description": "Stores transactions for a specific family."
    },
    "/families/{familyId}/settings/config": {
      "schema": {
        "$ref": "#/entities/Settings"
      },
      "description": "Stores settings for a specific family."
    },
    "/families/{familyId}/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/AppNotification"
      },
      "description": "Stores notifications for a specific family."
    },
    "/families/{familyId}/goals/{goalId}": {
      "schema": {
        "$ref": "#/entities/Goal"
      },
      "description": "Stores shared financial goals for a specific family."
    },
    "/families/{familyId}/bills/{billId}": {
      "schema": {
        "$ref": "#/entities/Bill"
      },
      "description": "Stores shared bills and recurring payments for a specific family."
    },
    "/families/{familyId}/categoryMappings/{mappingId}": {
      "schema": {
        "$ref": "#/entities/CategoryMapping"
      },
      "description": "Stores AI-learned category mappings for a specific family."
    }
  }
}
